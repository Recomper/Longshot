#!/bin/sh
# The Longshot AppImage: the builder window (builder/linux/longshot_builder.py) with everything it builds the game with -
# Python and the tools, clang and lld, a glibc 2.35 sysroot, FFmpeg, SDL2 and the Vulkan back end, built already.
#   Longshot.AppImage                  the builder window (Play is in the window, once a game is built)
#   Longshot.AppImage --play           start the game the builder saved, without opening the window
#   Longshot.AppImage --play <folder>  start the game in that folder
#   Longshot.AppImage <folder>         the same
#   Longshot.AppImage --cli <args>     nx2/make_game.py itself, e.g. --cli --nup game.nup --out ~/Games/Longshot
#   Longshot.AppImage --launch <dir>  the game folder's launcher: Play, and Update when a newer release is out
#   Longshot.AppImage --update <dir>  download the new release (only the parts that changed) and build that folder again
HERE="$(dirname "$(readlink -f "$0")")"
LIB="$HERE/usr/lib/longshot"
export LONGSHOT_TOOLS="$HERE/usr/share/longshot"
export EMSDK="$LIB/emsdk"
export LONGSHOT_SYSROOT="$LIB/sysroot"
export LONGSHOT_FFMPEG="$LIB/ffmpeg"
export LONGSHOT_VK_PREBUILT="$LIB/longshot_vk.so"
export LONGSHOT_SDL2="$LIB/libSDL2-2.0.so.0"
# (written into the game folder's longshot_version.txt, so its launcher finds this builder)
if [ -n "${APPIMAGE:-}" ]; then
    export LONGSHOT_BUILDER_EXE="$APPIMAGE"
else
    export LONGSHOT_BUILDER_EXE="$HERE/AppRun"
fi
PY="$HERE/usr/python/bin/python3"
if [ "${1:-}" = "--cli" ]; then
    shift
    exec "$PY" -I "$LONGSHOT_TOOLS/nx2/make_game.py" "$@"
fi
# Play is the same AppImage: the start script drops this image's libraries, then runs the built game.
if [ "${1:-}" = "--play" ]; then
    shift
    exec "$LONGSHOT_TOOLS/builder/linux/longshot-launch" "$@"
fi
if [ -n "${1:-}" ] && [ -d "$1" ]; then
    exec "$LONGSHOT_TOOLS/builder/linux/longshot-launch" "$1"
fi
exec "$PY" -I "$LONGSHOT_TOOLS/builder/linux/longshot_builder.py" "$@"
